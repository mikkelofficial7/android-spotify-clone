<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_notification_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:alpha=".3"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        tools:src="@drawable/is_spotify_green" />

    <ImageView
        android:id="@+id/iv_album"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fading_effect"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"/>

    <LinearLayout
        android:id="@+id/layout_playback"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/iv_subtitle_notification"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/btn_previous"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_previous"
            android:tint="@color/black80"
            android:padding="5dp"
            android:layout_marginEnd="5dp"
            tools:ignore="UseAppTint" />

        <ImageView
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_play"
            android:tint="@color/black80"
            android:padding="5dp"
            android:layout_marginEnd="5dp"
            tools:ignore="UseAppTint" />

        <ImageView
            android:id="@+id/btn_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_next"
            android:tint="@color/black80"
            android:padding="5dp"
            android:layout_marginEnd="5dp"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <ImageView
        android:id="@+id/iv_notification"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:adjustViewBounds="true"
        tools:src="@drawable/is_spotify_green" />

    <TextView
        android:id="@+id/iv_title_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_marginStart="4dp"
        tools:text="This is title"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginEnd="130dp"
        android:layout_alignStart="@id/iv_title_notification"
        android:layout_toLeftOf="@id/layout_playback"
        android:layout_alignTop="@id/iv_notification"
        android:layout_toEndOf="@id/iv_notification"/>

    <TextView
        android:id="@+id/iv_subtitle_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="This is description"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_toLeftOf="@id/layout_playback"
        android:layout_below="@id/iv_title_notification"
        android:layout_alignStart="@id/iv_title_notification"/>

</RelativeLayout>