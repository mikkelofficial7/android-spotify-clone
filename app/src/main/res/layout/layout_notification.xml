<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:background="@color/white"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_notification_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:adjustViewBounds="true"
        tools:src="@drawable/ic_play" />

    <ImageView
        android:id="@+id/iv_album"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fading_effect"
        android:layout_toRightOf="@id/iv_title_notification"
        android:layout_alignParentTop="true"/>

    <ImageView
        android:id="@+id/iv_notification"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:adjustViewBounds="true"
        tools:src="@drawable/is_spotify_green" />

    <TextView
        android:id="@+id/iv_title_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_marginStart="4dp"
        tools:text="@string/app_name"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_alignTop="@id/iv_notification"
        android:layout_toEndOf="@id/iv_notification"/>

    <TextView
        android:id="@+id/iv_subtitle_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="@string/app_name"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:layout_marginTop="5dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_below="@id/iv_title_notification"
        android:layout_alignStart="@id/iv_title_notification"/>

    <ProgressBar
        android:id="@+id/notification_seekbar"
        android:layout_width="0dp"
        android:layout_height="15dp"
        android:max="100"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/iv_notification"/>

    <TextView
        android:id="@+id/tv_timer_notification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="00.33"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_below="@id/notification_seekbar"
        android:layout_alignStart="@id/notification_seekbar"/>

    <TextView
        android:id="@+id/tv_timer_notification_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="00.33"
        style="@style/TextAppearance.Compat.Notification.Line2"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_below="@id/notification_seekbar"
        android:layout_alignEnd="@id/notification_seekbar"/>
</RelativeLayout>